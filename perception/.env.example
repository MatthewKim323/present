# perception/.env: copy to .env (gitignored). Loaded by perception/config.py at import; real env vars win.
# Also read by scripts/take.sh (DIRECTOR_TOKEN / WORLD_HOOKS_SECRET) and ~/dev/qm/scripts/world-dev.sh (ANTHROPIC_API_KEY).
# The loader takes everything after the first "=" as the value, so keep comments on their own lines.
# No real secrets here. Placeholders only.

# ---- keys ------------------------------------------------------------------
# Extraction + live pass + watch parse. Without it only conversation.completed is emitted.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ---- QM (execution layer) ----------------------------------------------------
# QMSink posts every WorldEvent to $QM_URL/world-events. Empty = no-op.
QM_URL=http://localhost:8091
# Bearer for QM. >= 16 chars. SAME value as WORLD_HOOKS_SECRET in ~/dev/qm/qm.env.
WORLD_HOOKS_SECRET=REPLACE_WITH_16_PLUS_CHARS
# Optional read-only bearer for /gbrain/* (QM passes it into sandboxes as GBRAIN_PROXY_TOKEN when set in qm.env).
# >= 16 chars. Unset = the proxy accepts WORLD_HOOKS_SECRET. Cannot post world events.
#GBRAIN_PROXY_TOKEN=
# Optional token for the /director console. Unset = WORLD_HOOKS_SECRET.
#DIRECTOR_TOKEN=

# ---- Builder (headless claude -p on the target repo) -----------------------
# 1: dispatch a Builder job on feature_request.detected without QM (deduped per event_id with QM's Builder worker).
BUILDER_AUTO=1
# 1: serve the PR branch locally (vite preview) and screenshot it for the HUD. Vercel blocks every [WORLD] PR preview.
BUILDER_LOCAL_PREVIEW=1
# GitHub repo the coder opens [WORLD] PRs on.
BUILDER_REPO=qtzx06/opal
# Part of the repo the coder may touch.
#BUILDER_SUBDIR=discord-bot
# Runs inside BUILDER_SUBDIR as the coder's last step (Memorable needs a passing check).
#BUILDER_VERIFY_CMD=python3 -m compileall -q core utils
# Model for the local claude -p run.
#BUILDER_MODEL=claude-sonnet-5
#BUILDER_CLAUDE_BIN=claude
# 0: strip ANTHROPIC_API_KEY so claude uses the logged-in subscription.
#BUILDER_USE_API_KEY=0
# Optional --mcp-config path for the coder. Empty = no MCP.
#BUILDER_MCP_CONFIG=
# GitHub poll interval, seconds.
#BUILDER_POLL_S=4
#BUILDER_TIMEOUT_S=900
#BUILDER_WORKDIR=data/builder
# Admitted Memorable drafts, recalled lexically into the next similar job.
#BUILDER_PROCEDURES_DIR=data/procedures
# LAN address the headset can reach for the local preview. Auto-detected when empty.
#BUILDER_PREVIEW_HOST=
#BUILDER_PREVIEW_PORT=4300
# Chrome binary for local preview screenshots.
#BUILDER_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Vercel "Protection Bypass for Automation" secret, if previews ever unblock.
#BUILDER_PREVIEW_BYPASS=
# Where MEMORABLE_API_URL / MEMORABLE_API_KEY are read from (repo root, gitignored). Set the two below to override.
#BUILDER_MEMORABLE_ENV=../.env.memorable
#MEMORABLE_API_URL=
#MEMORABLE_API_KEY=

# ---- models + timing -----------------------------------------------------------
# End-of-conversation extraction. Default claude-sonnet-5 took 9.4s; haiku is ~2s.
WORLD_LLM_MODEL=claude-haiku-4-5
# Live relationship pass every ~20s / 4 utterances (~2.2s).
WORLD_LIVE_MODEL=claude-haiku-4-5
#WORLD_LIVE_EVERY_S=20
#WORLD_LIVE_EVERY_N=4
# 0 disables live passes.
#WORLD_LIVE=1
# world.watch_requested parse.
#WORLD_WATCH_MODEL=claude-haiku-4-5
# Seconds of silence that end a conversation. Default 10; 5 on stage so extraction fires while Matthew is still there.
WORLD_CONV_GAP=5
# Seconds after the person leaves frame.
#WORLD_LEAVE_GRACE=8
# Per person, seconds.
#WORLD_ENCOUNTER_DEBOUNCE=60

# ---- who is wearing it, where --------------------------------------------------
WORLD_WEARER_ID=stephen
WORLD_WEARER_NAME=Stephen
# JSON object {"name","place","date","slug"}, path to a JSON file, or a plain name. Unset = YC hackathon, San Francisco, 2026-09-27.
#WORLD_SITUATION=

# ---- GBrain ----------------------------------------------------------------------
# io | stub | empty = auto (io when perception/.env.gbrain exists; create it with: uv run python -m perception.gbrain_auth).
GBRAIN_MODE=
# Seconds between timeline "seen" rows per person.
#GBRAIN_ENCOUNTER_DEBOUNCE=600

# ---- service / perception ------------------------------------------------------
#WORLD_HOST=0.0.0.0
#WORLD_PORT=8787
# faster-whisper | none
#WORLD_ASR=faster-whisper
# Try small.en.
#WORLD_ASR_MODEL=base.en
# SFace cosine, top-3 mean.
#WORLD_MATCH_THRESHOLD=0.40
#WORLD_DETECT_SCORE=0.8
#WORLD_DETECT_MAX_SIDE=640
# Min face height as a fraction of the frame.
#WORLD_MIN_FACE=0
#WORLD_TRACK_MAX_AGE=1.0
#WORLD_ENROLL_SAMPLES=12
#WORLD_VAD_MARGIN_DB=6
#WORLD_VAD_MIN_DB=-58
# world.entity_adopted debounce per person, seconds.
#WORLD_PINCH_DEBOUNCE_S=10
#WORLD_PEOPLE_PATH=data/people.json
#WORLD_EVENTS_LOG=data/events.jsonl
# 0 disables the GitHub cockpit feed.
#DEVFEED=1
# Default BUILDER_REPO.
#DEVFEED_REPO=
# Separate GitHub token so approve/comment come from a second actor.
#DEVFEED_GH_TOKEN=
# 1: show non-[WORLD] PRs too.
#DEVFEED_ALL_PRS=0
# Browser-side bearer for /qm/* routes in the service drawer. Unset = those routes answer 503.
#WORLD_QM_ACCESS_TOKEN=
