{
  "version": 1,
  "types": ["person", "commitment", "decision", "feedback", "insight", "memory", "agent", "swarm", "approval", "draft", "checklist", "procedure", "timer", "metric", "compare", "meeting", "reminder", "navigation", "object", "bug", "code", "note", "quote", "status"],
  "tool": {
    "type": "function",
    "function": {
      "name": "world_panel",
      "description": "Show, update, or dismiss a minimal spatial panel in WORLD. Use a stable id to update existing content. At most 3 panels are visible. Never interpret displaying an approval panel as consent: wait for a panel action. Actions only record the user's selection; they never execute external work.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "id"],
        "properties": {
          "op": {"type": "string", "enum": ["show", "update", "dismiss"]},
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$"},
          "type": {"type": "string", "enum": ["person", "commitment", "decision", "feedback", "insight", "memory", "agent", "swarm", "approval", "draft", "checklist", "procedure", "timer", "metric", "compare", "meeting", "reminder", "navigation", "object", "bug", "code", "note", "quote", "status"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S"},
          "body": {"type": "string", "maxLength": 240},
          "eyebrow": {"type": "string", "maxLength": 40},
          "meta": {"type": "string", "maxLength": 80},
          "value": {"type": "string", "maxLength": 32},
          "unit": {"type": "string", "maxLength": 24},
          "progress": {"type": "number", "minimum": 0, "maximum": 1},
          "items": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string", "maxLength": 72}, "value": {"type": "string", "maxLength": 72}, "done": {"type": "boolean"}, "state": {"type": "string", "enum": ["waiting", "running", "done", "failed"]}}}},
          "actions": {"type": "array", "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-zA-Z0-9_-]+$"}, "label": {"type": "string", "maxLength": 24}}}},
          "position": {"type": "string", "enum": ["left", "center", "right"]},
          "anchor_track_id": {"type": ["integer", "string", "null"]},
          "ttl_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000}
        }
      }
    }
  }
}
